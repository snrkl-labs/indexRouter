<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Loopback only: the server binds 127.0.0.1 and nothing leaves the device.
         GrapheneOS enforces its per-app Network toggle at socket creation,
         loopback included, so this permission and the on-device toggle are both
         still required. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- The receiver is invoked externally by the Pebble app and never by the
         user opening this app, so it has to survive backgrounding. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Vault access. On GrapheneOS this request is answered with Storage Scopes:
         the user grants specific folders (_RingRing for the app's own files, plus each
         folder the routing rules target) and the app sees only those, while using
         ordinary filesystem paths. On stock Android the same permission means
         all-files access, hence the SAF fallback for anyone not on GrapheneOS. -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />

    <!-- Without this, the first voice note after every reboot is lost silently. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Not for drawing anything. Since Android 10 a background app cannot start
         an activity, which is what firing a timer or a calendar insert requires;
         holding this is the exemption that lets those fire without the user
         tapping a notification first. Optional — the app degrades to a
         tap-to-fire notification when it is not granted. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- Needed to resolve the timer and calendar handlers on API 30+. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.SET_TIMER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.INSERT" />
            <data android:mimeType="vnd.android.cursor.dir/event" />
        </intent>
        <!-- The calendar route can hand the spoken phrase to one named app for
             its own language parser. Declared as an intent rather than a fixed
             package because which app is a setting; without this, API 30+ hides
             it and resolveActivity reports "not installed" for an app that is. -->
        <intent>
            <action android:name="android.intent.action.SEND" />
            <data android:mimeType="text/plain" />
        </intent>
    </queries>

    <application
        android:name=".IndexRouterApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.App">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- specialUse, not dataSync: nothing is being transferred, and dataSync
             takes a 6h-per-24h runtime cap once targetSdk reaches 35 — fatal for
             a listener that must be up whenever the ring is worn. -->
        <service
            android:name=".service.RouterForegroundService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Runs a loopback-only HTTP listener that receives voice-note webhooks from the paired Pebble app. Delivery is initiated externally by a ring gesture at an arbitrary time, so the listener must remain bound whenever the device is on." />
        </service>

        <!--
            The voice input method. Not the system recogniser: HeliBoard's mic
            key switches the active input method to an enabled IME carrying a
            voice subtype, so this is what sits on the end of that key. Ordinary
            voice typing elsewhere on the phone is untouched.
        -->
        <service
            android:name=".voice.VoiceInputMethodService"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_INPUT_METHOD">
            <intent-filter>
                <action android:name="android.view.InputMethod" />
            </intent-filter>
            <meta-data
                android:name="android.view.im"
                android:resource="@xml/voice_input_method" />
        </service>

        <receiver
            android:name=".service.BootReceiver"
            android:exported="true"
            tools:ignore="UnusedAttribute">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

    </application>

</manifest>
