<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        The UI is entirely Compose, so this theme only has to get the window
        right before the first frame: no action bar (Compose draws its own top
        bar) and a DayNight background so a dark-mode launch does not flash
        white before the composition arrives.

        DayNight has no NoActionBar variant in the platform themes, so the bar
        is turned off here rather than by picking a different parent.
    -->
    <style name="Theme.App" parent="android:Theme.DeviceDefault.DayNight">
        <item name="android:windowActionBar">false</item>
        <item name="android:windowNoTitle">true</item>
    </style>
</resources>
